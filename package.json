{
  "name": "web3-scaffold",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "22.x",
    "pnpm": "12.x"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @web3-scaffold/app dev",
    "build": "pnpm --filter @web3-scaffold/app build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prettier": "pnpm -r prettier"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
